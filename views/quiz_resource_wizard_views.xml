<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_quiz_resource_create_wizard_form" model="ir.ui.view">
        <field name="name">quiz.resource.create.wizard.form</field>
        <field name="model">quiz.resource.create.wizard</field>
        <field name="arch" type="xml">
            <form string="Create Quiz Resource">
                <group>
                    <field name="quiz_id" readonly="1"/>
                    <field name="parent_resource_id"
                           options="{'no_create': True}"/>
                </group>
                <footer>
                    <button name="action_create_resource"
                            string="Create Resource"
                            type="object"
                            class="btn-primary"/>
                    <button string="Cancel"
                            special="cancel"
                            class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
