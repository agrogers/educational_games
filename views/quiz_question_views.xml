<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_quiz_question_list" model="ir.ui.view"><field name="name">quiz.question.list</field><field name="model">quiz.question</field><field name="arch" type="xml">
        <list string="Questions" multi_edit="1"><header><button name="action_open_import_wizard" string="Import Questions" type="object" icon="fa-upload"/><button name="action_open_tag_wizard" string="Bulk Modify" type="object" icon="fa-pencil"/><button name="action_merge_questions" string="Merge Questions" type="object" icon="fa-compress"/></header><field name="id" string="ID" optional="show"/><field name="quiz_id" optional="hide"/><field name="sequence" widget="handle" optional="hide"/><field name="question_text" widget="html" optional="hide" class="text-wrap quiz-question-text"/><field name="correct_answer" widget="html" optional="hide" class="text-wrap quiz-answer-text"/><field name="marks" optional="hide"/><field name="import_group" optional="show"/><field name="subject_ids" widget="many2many_tags" optional="show"/><field name="tag_ids" widget="many2many_tags" optional="show"/><field name="create_date" string="Created" optional="show"/><field name="correct_answer_count" string="Correct Options" optional="hide"/><field name="attempt_count" string="Attempts" optional="show"/><field name="pct_correct_all" string="% Correct" optional="show"/><field name="pct_correct_recent" string="% Correct (1h)" optional="hide"/></list></field></record>
    <record id="view_quiz_question_search" model="ir.ui.view"><field name="name">quiz.question.search</field><field name="model">quiz.question</field><field name="arch" type="xml">
        <search string="Search Questions"><field name="question_text" string="Question"/><field name="correct_answer" string="Correct Answer"/><field name="quiz_id"/><field name="all_quiz_ids" string="Quiz"/><field name="import_group"/><field name="subject_ids"/><field name="tag_ids"/><separator/><filter string="Multiple Answers" name="filter_multiple" domain="[('allow_multiple', '=', True)]"/><filter string="Has Subject" name="filter_has_subject" domain="[('subject_ids', '!=', False)]"/><filter string="Has Tag" name="filter_has_tag" domain="[('tag_ids', '!=', False)]"/><group expand="0" string="Group By"><filter string="Quiz" name="group_by_quiz" context="{'group_by': 'quiz_id'}"/><filter string="Import Group" name="group_by_import_group" context="{'group_by': 'import_group'}"/><filter string="Subject" name="group_by_subject" context="{'group_by': 'subject_ids'}"/><filter string="Tags" name="group_by_tags" context="{'group_by': 'tag_ids'}"/><filter string="Allow Multiple Answers" name="group_by_allow_multiple" context="{'group_by': 'allow_multiple'}"/></group><searchpanel><field name="all_quiz_ids" string="Quiz" select="multi" icon="fa-list-alt" enable_counters="1"/><field name="subject_ids" string="Subject" select="multi" icon="fa-book" enable_counters="1"/><field name="tag_ids" string="Tag" select="multi" icon="fa-tag" enable_counters="1"/></searchpanel></search></field></record>
    <record id="view_quiz_question_form" model="ir.ui.view"><field name="name">quiz.question.form</field><field name="model">quiz.question</field><field name="arch" type="xml">
        <form string="Question"><sheet><div class="oe_title"><label for="question_text" string="Question"/><field name="question_text" widget="html" placeholder="Enter the question…"/></div><notebook><page string="Answers" name="answers"><field name="answer_ids"><list editable="bottom" string="Answers" decoration-success="is_correct"><field name="sequence" widget="handle"/><field name="answer_text" widget="html" string="Answer Text"/><field name="is_correct" string="Correct?"/><field name="create_date" string="Created" readonly="1" optional="show"/><field name="select_count" readonly="1" string="Selected" optional="show"/><field name="select_pct_all" readonly="1" string="% (All)" optional="show"/><field name="select_pct_recent" readonly="1" string="% (1h)" optional="hide"/></list></field></page><page string="Responses" name="responses"><group><field name="pct_correct_all" readonly="1" string="% Correct"/><field name="attempt_count" readonly="1" string="Attempts"/></group><field name="response_ids" string="Student Responses"><list editable="top" string="Student Responses" decoration-success="is_correct" decoration-danger="not is_correct"><field name="create_date" string="Date Attempted" optional="show"/><field name="user_id" string="Student" optional="show"/><field name="answer_id" string="Selected Answer" optional="show"/><field name="result_label" string="Result" widget="badge" decoration-success="is_correct" decoration-danger="not is_correct" optional="show"/><field name="is_correct" string="Correct?" optional="hide"/><field name="attempt_token" string="Attempt Token" optional="hide"/></list></field></page><page string="Info" name="info"><group><group><field name="quiz_id" string="Primary Quiz"/><field name="sequence"/><field name="marks"/><field name="allow_multiple"/><field name="import_group"/><field name="subject_ids" widget="many2many_tags" options="{'no_create': True}"/><field name="tag_ids" widget="many2many_tags" options="{'no_create': False}"/></group><group><field name="correct_answer_count" readonly="1" string="Correct Options"/><field name="correct_answer" readonly="1" widget="html"/><field name="pct_correct_recent" readonly="1" string="% Correct (1h)"/></group></group><group><field name="all_quiz_ids" widget="many2many_tags" options="{'no_create': True}" help="All quizzes this question belongs to."/></group></page></notebook></sheet></form></field></record>
</odoo>
