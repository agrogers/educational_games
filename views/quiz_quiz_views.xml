<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_quiz_quiz_list" model="ir.ui.view"><field name="name">quiz.quiz.list</field><field name="model">quiz.quiz</field><field name="arch" type="xml">
        <list string="Quizzes"><field name="name"/><field name="subject_ids" widget="many2many_tags" optional="show"/><field name="question_count"/><field name="total_marks"/><field name="create_date" string="Created" optional="show"/></list></field></record>
    <record id="view_quiz_quiz_search" model="ir.ui.view"><field name="name">quiz.quiz.search</field><field name="model">quiz.quiz</field><field name="arch" type="xml">
        <search string="Search Quizzes"><field name="name"/><field name="subject_ids"/><field name="filter_tag_ids" string="Tag"/><separator/><filter string="Allow Resubmission" name="filter_allow_resubmission" domain="[('allow_resubmission', '=', True)]"/><filter string="Has Questions" name="filter_has_questions" domain="[('question_ids', '!=', False)]"/><group expand="0" string="Group By"><filter string="Subject" name="group_by_subject" context="{'group_by': 'subject_ids'}"/><filter string="Tag" name="group_by_tag" context="{'group_by': 'filter_tag_ids'}"/><filter string="Allow Resubmission" name="group_by_resubmission" context="{'group_by': 'allow_resubmission'}"/></group><searchpanel><field name="subject_ids" string="Subject" select="multi" icon="fa-book" enable_counters="1"/><field name="filter_tag_ids" string="Tag" select="multi" icon="fa-tag" enable_counters="1"/></searchpanel></search></field></record>
    <record id="view_quiz_quiz_form" model="ir.ui.view"><field name="name">quiz.quiz.form</field><field name="model">quiz.quiz</field><field name="arch" type="xml">
        <form string="Quiz"><header><button name="action_preview_quiz" string="Preview Quiz" type="object" class="btn btn-secondary" icon="fa-eye"/></header><sheet><div class="oe_title"><label for="name" string="Quiz Name"/><h1><field name="name" placeholder="e.g. Business English – Formal Letters"/></h1></div><notebook><page string="Settings" name="settings"><group><group string="Display Settings"><field name="quiz_type"/><field name="question_count" readonly="1" invisible="quiz_type == 'memory_reveal'"/><field name="total_marks" readonly="1" invisible="quiz_type == 'memory_reveal'"/><field name="subject_ids" widget="many2many_tags" options="{'no_create': True}"/><field name="display_question_count" invisible="quiz_type == 'memory_reveal'"/><field name="display_option_count" invisible="quiz_type == 'memory_reveal'"/><field name="allow_resubmission" invisible="quiz_type == 'memory_reveal'"/></group><group class="quiz-form-header-image" invisible="quiz_type == 'memory_reveal'"><field name="header_image" widget="image" string="Header Image" options="{'size': [400, 50]}" nolabel="1"/><field name="description" widget="html" placeholder="Optional description shown to students…"/></group><group string="Memory Reveal Image" invisible="quiz_type != 'memory_reveal'"><field name="image_content" widget="html" options="{'image_upload': True}" nolabel="1" placeholder="Paste or upload an image. The first image found will be used as the quiz image."/></group></group><group string="Inherited Quizzes"><div class="alert alert-info m-2" role="alert">Questions from the quizzes below are automatically included when this quiz is played. Circular references are not allowed.</div><field name="include_other_quizzes" widget="clickable_many2many_tags" options="{'no_create': True, 'no_open': False}" colspan="2" placeholder="Select quizzes to inherit questions from…"/></group><group><field name="filter_summary_preview" readonly="1" widget="text" colspan="2" placeholder="No active filters."/><field name="quiz_url_params" readonly="1" string="APEX Game URL" widget="CopyClipboardChar" help="Paste this into the resource URL field in APEX to open this quiz. The format is action:&lt;id&gt;?quiz_id=&lt;id&gt;&amp;… matching the pattern used by other games."/></group><group string="Question Filters"><div class="alert alert-success m-2" colspan="2" role="alert">These filters will include questions that have at least one tag AND one subject.</div><group><field name="filter_tag_ids" widget="many2many_tags" options="{'no_create': False}" placeholder="Any matching tags..."/></group><group><field name="filter_subject_ids" widget="many2many_tags" options="{'no_create': True}" placeholder="Any matching subjects..."/></group><group string="Student's Own Answer History"><div class="alert alert-warning" role="alert">These filters will exclude questions that satisfy ALL the critiera below.</div><field name="filter_student_attempts" placeholder="Leave empty to ignore"/><field name="filter_student_weighted_score_pct" placeholder="Leave empty to ignore"/><field name="filter_exclude_answered_days" placeholder="Leave empty to ignore"/></group><group string="All Students' History"><div class="alert alert-success" role="alert">These filters will include questions that satisfy ALL critiera.</div><field name="filter_min_attempts" placeholder="Leave empty to ignore"/><field name="filter_max_attempts" placeholder="Leave empty to ignore"/><field name="filter_max_pct_correct" placeholder="Leave empty to ignore"/></group></group></page><page string="Questions" name="questions" invisible="quiz_type == 'memory_reveal'"><div class="mb-2"><button name="%(educational_games.action_quiz_question_import)d" string="Import Questions" type="action" class="btn btn-secondary" icon="fa-upload" context="{'default_quiz_id': id}"/><span class="me-2 border-start d-inline-block" style="height: 1.5em; vertical-align: middle;"/><button name="%(educational_games.action_quiz_question_list)d" string="Open Questions List" type="action" class="btn btn-secondary" icon="fa-external-link" context="{'search_default_all_quiz_ids': id}"/></div><field name="question_ids" context="{'default_quiz_id': id}"><list string="Questions"><field name="id" string="ID" optional="show"/><field name="sequence" widget="handle" optional="hide"/><field name="question_text" widget="html" string="Question" optional="hide" class="quiz-question-text"/><field name="correct_answer" widget="html" optional="hide" class="quiz-answer-text"/><field name="marks" optional="hide"/><field name="import_group" optional="hide"/><field name="subject_ids" widget="many2many_tags" optional="show"/><field name="tag_ids" widget="many2many_tags" optional="show"/><field name="correct_answer_count" string="Correct Options" optional="hide"/><field name="attempt_count" string="Attempts" optional="show"/><field name="pct_correct_all" string="% Correct" optional="show"/><field name="pct_correct_recent" string="% Correct (1h)" optional="hide"/><field name="create_date" string="Created" optional="show"/></list></field></page><page string="Image Setup" name="image_setup" invisible="quiz_type != 'memory_reveal'"><div class="alert alert-info m-2" role="alert"><strong>Memory Reveal Setup:</strong> Each question represents a blurred region on the image.</div><div class="mb-2"><button name="action_open_memory_reveal_setup" string="Open Image Setup" type="object" class="btn btn-primary" icon="fa-crop"/></div><field name="question_ids" context="{'default_quiz_id': id}"><list string="Regions"><field name="id" string="ID" optional="show"/><field name="sequence" widget="handle" optional="hide"/><field name="question_text" widget="html" string="Region Name" class="quiz-question-text"/><field name="region_x1" string="Left %" optional="show"/><field name="region_y1" string="Top %" optional="show"/><field name="region_x2" string="Right %" optional="show"/><field name="region_y2" string="Bottom %" optional="show"/><field name="create_date" string="Created" optional="show"/></list></field></page><page string="Bulk Add by ID" name="bulk_add" invisible="quiz_type == 'memory_reveal'"><div class="alert alert-info" role="alert"><strong>Bulk Add by Question ID:</strong><p class="mb-1 mt-1">Paste IDs separated by commas, spaces, or new lines. Click <strong>Check</strong> to stage questions, remove unwanted rows, then click <strong>Add Questions</strong>.</p></div><group><field name="bulk_add_question_ids_text" placeholder="Example: 12, 15 21 34"/></group><div class="mt-2 d-flex gap-2 flex-wrap"><button name="action_bulk_check_question_ids" string="Check" type="object" class="btn btn-secondary" icon="fa-check"/><button name="action_bulk_add_questions" string="Add Questions" type="object" class="btn btn-primary" icon="fa-plus"/></div><field name="bulk_add_question_ids"><list string="Staged Questions" create="0" delete="1" editable="bottom"><field name="id"/><field name="question_text" widget="html" optional="show" class="quiz-question-text"/><field name="correct_answer" widget="html" optional="show" class="quiz-answer-text"/><field name="subject_ids" widget="many2many_tags" optional="show"/><field name="tag_ids" widget="many2many_tags" optional="show"/><field name="import_group" optional="show"/><field name="marks" optional="show"/><field name="create_date" string="Created" optional="show"/></list></field></page><page string="Statistics" name="statistics"><widget name="quiz_statistics"/></page></notebook></sheet></form></field></record>
    <record id="action_quiz_list_view_list" model="ir.actions.act_window.view"><field name="sequence">1</field><field name="view_mode">list</field><field name="view_id" ref="view_quiz_quiz_list"/><field name="act_window_id" ref="educational_games.action_quiz_list"/></record>
    <record id="action_quiz_list_view_form" model="ir.actions.act_window.view"><field name="sequence">2</field><field name="view_mode">form</field><field name="view_id" ref="view_quiz_quiz_form"/><field name="act_window_id" ref="educational_games.action_quiz_list"/></record>
</odoo>
